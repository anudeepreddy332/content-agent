# Copy to .env and fill in. .env is gitignored and .dockerignored — never committed, never baked.
DEEPSEEK_API_KEY=sk-...
TAVILY_API_KEY=tvly-...
# Long random string. The API server refuses to start auth without it.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_BEARER_TOKEN=

# Optional overrides (sane defaults in config.py)
# DEEPSEEK_MODEL=deepseek-chat
# QDRANT_COLLECTION=machinist_evergreen

# Optional LangSmith tracing — OFF unless ALL THREE are set (see docs/LANGSMITH.md).
# LANGSMITH_TRACING=1
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=content-agent-dev

# Publish target is fail-closed. Unset = no local merge and no remote push.
# Client demos MUST use the demo fork, never themachinist.org / themachinist-website.
# PUBLISH_TARGET=demo
# THEMACHINIST_REPO_PATH=/absolute/path/to/themachinist-website-fork
# PUBLISH_REMOTE=demo
# NETLIFY_BASE_URL=https://tmw-demo-site.netlify.app
# GIT_PUSH_ENABLED=true
# Production publish additionally requires CONFIRM_PRODUCTION_PUBLISH=I_UNDERSTAND.
# Do not set those production vars for a client rehearsal.